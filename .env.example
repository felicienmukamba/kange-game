# Copy to .env and adjust. Used by docker-compose.yml.

# Database
POSTGRES_USER=rewify
POSTGRES_PASSWORD=change-me

# Base64-encoded 256-bit key used to sign JWTs. Generate with: openssl rand -base64 32
JWT_SECRET=

# Comma-separated origins allowed to call the API / WebSocket
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Host port for the API (change if 8080 is taken on your machine)
BACKEND_PORT=8080

# URLs the browser uses to reach the API. Baked into the frontend image at build time.
PUBLIC_API_URL=http://localhost:8080/api/v1
PUBLIC_WS_URL=http://localhost:8080/ws

# Optional — AI quiz generation & chat moderation (set SPRING_AI_MODEL_CHAT=openai to enable)
SPRING_AI_MODEL_CHAT=none
OPENAI_API_KEY=

# Optional — live video via LiveKit (secret must be at least 32 characters)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
